# Clearcote build configuration — Linux arm64 (aarch64) target, cross-compiled from an x64 host.
#
# A SEPARATE file (config/args.linux.gn stays the native x64 build). This is args.linux.gn with
# the target flipped to arm64:
#   1. target_cpu  = "arm64"   (was "x64")
#   2. target_sysroot = "//build/linux/debian_bullseye_arm64-sysroot"
#
# WHY a host-side cross (not a native arm64 build): the prebuilt x64 clang Chromium ships is
# multi-target and compiles arm64 code — exactly how Chromium produces arm64-Linux binaries.
# `use_sysroot=true` + `target_sysroot` wire the arm64 sysroot onto the TARGET toolchain only:
# GN scopes sysroot per toolchain, so the arm64 target (current_cpu==arm64) links against the
# arm64 bullseye sysroot while the x64 host tools keep the amd64 sysroot. Without `target_sysroot`
# the arm64 target pulls the host's /usr/include (x64 glibc) and fails on bits/wordsize.h.
# Both sysroots must be installed: 02-host-toolchain.sh does amd64 (host); the arm64 one is
# installed by scripts/fresh-arm64.sh (install-sysroot.py --arch=arm64).
#
# Everything else — the de-Google set and the release config — is identical to the x64 build.
# scripts/fresh-arm64.sh copies this to out/Default/args.gn for the arm64 build.
#
# IMPORTANT (host requirement): the x64 host TOOLS (mksnapshot, V8 builtin generators) must run
# on a REAL x86-64 CPU. Built under Rosetta 2 on an Apple Silicon Mac they silently corrupt the
# V8 snapshot (Math.PI -> 3). Build on a native x86-64 host — see docs/BUILD-ARM64.md.

# --- De-Google (from ungoogled-chromium's flags.gn; kept explicit so this file is self-contained) ---
clang_use_chrome_plugins = false
disable_fieldtrial_testing_config = true
enable_hangout_services_extension = false
enable_mdns = false
enable_remoting = false
enable_reporting = false
enable_service_discovery = false
# Widevine EME *plumbing* only — clearcote does NOT bundle Google's proprietary CDM blob; the SDK
# fetches it opt-in at runtime (Linux uses the CDM hint file, see sdk/python/clearcote/_widevine.py).
enable_widevine = true
exclude_unwind_tables = true
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
safe_browsing_mode = 0
use_official_google_api_keys = false
use_unofficial_version_number = false

# --- Target + toolchain (Linux arm64 target, cross from x64 host) ---
target_os = "linux"
target_cpu = "arm64"
is_clang = true
clang_base_path = "//third_party/llvm-build/Release+Asserts"
use_sysroot = true                    # per-toolchain sysroot logic in build/config/sysroot.gni
# Cross-compile knob: sysroot.gni sets the arm64 target toolchain's sysroot to this, and
# build/config/posix/BUILD.gn emits --sysroot=<it> on every C/C++/asm/ld invocation for that
# toolchain. The x64 host toolchain is unaffected (it uses debian_bullseye_amd64-sysroot).
target_sysroot = "//build/linux/debian_bullseye_arm64-sysroot"

# --- Release configuration (identical to the Windows build) ---
is_debug = false
is_official_build = false             # matches the published pre-release; see docs/RELEASING.md
is_component_build = false            # single, shippable binary
symbol_level = 0
blink_symbol_level = 0
chrome_pgo_phase = 0                  # no downloaded PGO profiles
use_remoteexec = false

# --- Media / codecs (match a normal desktop browser) ---
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# --- Build hygiene ---
enable_nacl = false
treat_warnings_as_errors = false
fatal_linker_warnings = false
v8_drumbrake_bounds_checks = true
